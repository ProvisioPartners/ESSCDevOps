<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LOI_Outcome__c</fullName>
    <description>Funder decision on the Letter of Intent. Accepted = invited to submit a full proposal (numerator for LOI Success Rate). Declined = LOI not invited forward. N/A = funder has no LOI step, so this record is excluded from LOI Success Rate. Independent of Stage so the outcome is retained after the opportunity moves on or is declined.</description>
    <label>LOI Outcome</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>true</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Accepted</fullName>
                <default>false</default>
                <label>Accepted</label>
            </value>
            <value>
                <fullName>Declined</fullName>
                <default>false</default>
                <label>Declined</label>
            </value>
            <value>
                <fullName>N/A</fullName>
                <default>false</default>
                <label>N/A</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
