    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>IF(
  AND(
    VALUE(GiftTransaction.PaymentInstrument.ExpiryYear) = YEAR(TODAY() + 60),
    VALUE(GiftTransaction.PaymentInstrument.ExpiryMonth) = MONTH(TODAY() + 60)
  ) 
  || 
  AND(
    VALUE(GiftTransaction.PaymentInstrument.ExpiryYear) = YEAR(TODAY()),
    VALUE(GiftTransaction.PaymentInstrument.ExpiryMonth) = MONTH(TODAY())
  ),
  1,
  0
)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Is Expiring Soon</label>
        <scale>0</scale>
    </customDetailFormulas>
    <description>Automated exception report tracking newly created gift transactions that failed today. This report utilizes a conditional subscription to email administrators only when the daily failed record count is greater than zero, eliminating empty inbox alerts.</description>
    <filter>
        <booleanFilter>(1 AND 2 AND 3) OR (2 AND 3 AND 4)</booleanFilter>
        <criteriaItems>
            <column>GiftTransaction$Status</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Failed</value>
        </criteriaItems>
        <criteriaItems>
            <column>GiftTransaction$GiftCommitment.ScheduleType</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Recurring</value>
        </criteriaItems>
        <criteriaItems>
            <column>GiftTransaction$CreatedDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>TODAY</value>
        </criteriaItems>
        <criteriaItems>
            <column>CDF1</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
    </filter>
    <format>Tabular</format>
    <name>Failed RecurringGift Transactions Report</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Gift_Transactions_Deluxe__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>GiftTransaction$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
