    <description>Logs a legislator interaction in one step: creates the Interaction, its Interaction Summary, and an Interaction Attendee for each selected related Contact.</description>
    <dynamicChoiceSets>
        <name>ContactChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxInteractionName</name>
        <dataType>String</dataType>
        <expression>LEFT({!InteractionTypeInput} &amp; &quot; - &quot; &amp; {!Get_Account.Name} &amp; &quot; - &quot; &amp; TEXT(DATEVALUE({!StartTimeInput})), 80)</expression>
    </formulas>
    <formulas>
        <name>fxSummaryName</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;Summary - &quot; &amp; {!Get_Account.Name} &amp; &quot; - &quot; &amp; TEXT(DATEVALUE({!StartTimeInput})), 80)</expression>
    </formulas>
    <interviewLabel>Log Interaction {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Log Interaction</label>
