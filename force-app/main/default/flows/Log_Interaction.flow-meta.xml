    <decisions>
        <name>Any_Attendees_Selected</name>
        <label>Any Attendees Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Redirect_to_Account_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Finish</defaultConnectorLabel>
        <rules>
            <name>Yes_Attendees</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AttendeeContacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Split_Selected_Contacts</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
