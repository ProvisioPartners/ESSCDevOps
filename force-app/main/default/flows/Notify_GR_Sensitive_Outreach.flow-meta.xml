    <description>Shared subflow. Notifies the GR Team public group when a non-GR team logs an activity against a Legislator Account flagged with Outreach Sensitivity. Called by Notify_GR_On_Sensitive_Task and Notify_GR_On_Sensitive_Event so the Account lookup and notification logic live in one place. Exits quietly if the WhatId is not an Account, the Account is not flagged, or the GR_Team group / notification type is missing.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxBody</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varLoggingTeam}), &apos;Another team&apos;, {!varLoggingTeam}) &amp;
&apos; logged a &apos; &amp; {!varActivityType} &amp; &apos; on &apos; &amp; {!Get_Flagged_Account.Name} &amp;
&apos;: &apos; &amp; {!varSubject}</expression>
    </formulas>
    <formulas>
        <name>fxTitle</name>
        <dataType>String</dataType>
        <expression>&apos;GR-sensitive outreach: &apos; &amp; {!Get_Flagged_Account.Name}</expression>
    </formulas>
    <interviewLabel>Notify GR Sensitive Outreach {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Notify GR Sensitive Outreach</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Flagged_Account</name>
        <label>Get Flagged Account</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Sensitive_Legislator</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varWhatId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Outreach_Sensitivity__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
