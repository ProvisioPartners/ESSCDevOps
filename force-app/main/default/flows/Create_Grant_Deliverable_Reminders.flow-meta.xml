    <description>Daily scheduled flow. Each morning it finds open Grant Deliverables (Deliverable__c, Status not Completed or Cancelled) whose Due Date is exactly 30 days out, exactly 7 days out, or exactly one day past. It creates a reminder Task owned by the Deliverable owner 30 days and 7 days before the Due Date, and an escalation Task owned by the related Opportunity owner (falling back to the Deliverable owner when no Opportunity is linked) the day after the Due Date passes while still incomplete. Every Task is related to the Deliverable (WhatId) for the link back. Equality on the date means each deliverable fires each reminder exactly once; editing the Due Date reschedules it and completing the deliverable stops future reminders. See docs/grant-deliverable-reminders.md.</description>
    <environments>Default</environments>
    <formulas>
        <name>Date_In_30</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>
    <formulas>
        <name>Date_In_7</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 7</expression>
    </formulas>
    <formulas>
        <name>Date_Yesterday</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 1</expression>
    </formulas>
    <formulas>
        <name>Escalation_Description</name>
        <dataType>String</dataType>
        <expression>&quot;This grant deliverable was due on &quot; &amp; TEXT({!Loop_Deliverables.Due_Date__c}) &amp; &quot; and is still not complete (Status: &quot; &amp; TEXT({!Loop_Deliverables.Status__c}) &amp; &quot;). Please follow up and resolve it.&quot;</expression>
    </formulas>
    <formulas>
        <name>Escalation_Owner</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_Deliverables.Opportunity__r.OwnerId}), {!Loop_Deliverables.OwnerId}, {!Loop_Deliverables.Opportunity__r.OwnerId})</expression>
    </formulas>
    <formulas>
        <name>Escalation_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;OVERDUE Grant Deliverable: &quot; &amp; {!Loop_Deliverables.Name}</expression>
    </formulas>
    <formulas>
        <name>Reminder_30_Description</name>
        <dataType>String</dataType>
        <expression>&quot;This grant deliverable is due on &quot; &amp; TEXT({!Loop_Deliverables.Due_Date__c}) &amp; &quot; (30 days away). Please begin the work needed to complete it on time.&quot;</expression>
    </formulas>
    <formulas>
        <name>Reminder_30_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Grant Deliverable due in 30 days: &quot; &amp; {!Loop_Deliverables.Name}</expression>
    </formulas>
    <formulas>
        <name>Reminder_7_Description</name>
        <dataType>String</dataType>
        <expression>&quot;This grant deliverable is due on &quot; &amp; TEXT({!Loop_Deliverables.Due_Date__c}) &amp; &quot; (7 days away). Please make sure it will be completed by the Due Date.&quot;</expression>
    </formulas>
    <formulas>
        <name>Reminder_7_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Grant Deliverable due in 7 days: &quot; &amp; {!Loop_Deliverables.Name}</expression>
    </formulas>
