<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Fires when a non-GR team logs a new Event against a record. Hands off to the Notify_GR_Sensitive_Outreach subflow, which checks whether the Related To record is a Legislator Account flagged with Outreach Sensitivity and, if so, notifies the GR Team public group. Entry criteria keep this off Events that carry no Related To.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxLoggingTeam</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Logging_Team__c})</expression>
    </formulas>
    <interviewLabel>Notify GR On Sensitive Event {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Notify GR On Sensitive Event</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Notify_GR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Logging_Team__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>GR</stringValue>
            </value>
        </filters>
        <object>Event</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Notify_GR</name>
        <label>Notify GR</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <flowName>Notify_GR_Sensitive_Outreach</flowName>
        <inputAssignments>
            <name>varActivityId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varActivityType</name>
            <value>
                <stringValue>Event</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varLoggingTeam</name>
            <value>
                <elementReference>fxLoggingTeam</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSubject</name>
            <value>
                <elementReference>$Record.Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varWhatId</name>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
