<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Gift_Category</name>
        <label>Set Gift Category</label>
        <locationX>50</locationX>
        <locationY>398</locationY>
        <assignmentItems>
            <assignToReference>$Record.Gift_Category__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Gift_Commitment.Gift_Category__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Commitment_Has_Category</name>
        <label>Commitment Has Category?</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>No - Leave Transaction Blank</defaultConnectorLabel>
        <rules>
            <name>Yes_Copy_Category</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Gift_Commitment.Gift_Category__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Gift_Category</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Copies Gift Category down from the parent Gift Commitment when a Gift Transaction is created, so staff do not re-enter it on transactions generated from a commitment. Runs before save on insert only, and only when the Transaction has a Gift Commitment and its own Gift Category is still blank - a category entered by hand is never overwritten.</description>
    <environments>Default</environments>
    <interviewLabel>Set Gift Category From Commitment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Gift Category From Commitment</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Gift_Commitment</name>
        <label>Get Gift Commitment</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Commitment_Has_Category</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.GiftCommitmentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GiftCommitment</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Gift_Category__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Gift_Commitment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GiftCommitmentId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Gift_Category__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>GiftTransaction</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
